{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workspace",
  "description": "The local main window can access workspace, companion controls, and user-selected backups.",
  "windows": ["main"],
  "permissions": [
    "allow-read-workspace",
    "allow-commit-workspace",
    "allow-export-backup",
    "allow-storage-info",
    "allow-list-recovery",
    "allow-read-recovery",
    "allow-companion-read",
    "allow-companion-update",
    "allow-desktop-action",
    "allow-ai-begin",
    "allow-ai-cancel",
    "allow-ai-request",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused"
  ]
}
